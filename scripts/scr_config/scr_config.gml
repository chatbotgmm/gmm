// ── 설정 ──
// 서버 주소: 지금 운영 서버(앱·웹게임과 같은 계정·자료). HTML5로 같은 서버에서 돌릴 때는 상대 주소를 쓴다(api_base).
#macro SERVER_URL "https://gmm.dpdns.org"
#macro APP_VERSION "gms2-0.1.0"
// 화면은 높이 540 기준. 너비는 화면 비율에 따라 960~1280(앱·웹게임과 같은 배치)
#macro DESIGN_H 540
#macro DESIGN_W_MIN 960
#macro DESIGN_W_MAX 1280
// 앱 「남색 작업대」 테마 색(NavyWorkbenchTheme)
#macro C_BACKDROP make_colour_rgb(7, 19, 28)
#macro C_PANEL make_colour_rgb(16, 36, 51)
#macro C_HEADER make_colour_rgb(19, 44, 59)
#macro C_SLOT make_colour_rgb(11, 30, 42)
#macro C_TEXT make_colour_rgb(245, 234, 208)
#macro C_MUTED make_colour_rgb(176, 190, 196)
#macro C_GOLD make_colour_rgb(217, 187, 127)
#macro C_GOLD_EDGE make_colour_rgb(243, 216, 158)
#macro C_EDGE make_colour_rgb(145, 122, 76)
#macro C_LINE make_colour_rgb(91, 103, 93)
#macro C_INK make_colour_rgb(27, 42, 51)
#macro C_PRIMARY make_colour_rgb(214, 180, 112)
#macro C_HP make_colour_rgb(111, 208, 138)
#macro C_MP make_colour_rgb(109, 184, 234)
#macro C_GOOD make_colour_rgb(159, 227, 168)
#macro C_BAD make_colour_rgb(255, 154, 138)
#macro C_RED make_colour_rgb(150, 58, 34)
#macro C_BLUE make_colour_rgb(32, 84, 136)
#macro C_GREEN make_colour_rgb(33, 96, 78)
#macro C_GRAY make_colour_rgb(55, 70, 80)
